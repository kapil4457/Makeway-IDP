# Copy to terraform.tfvars (gitignored) and fill in your values.
# Never commit this file — it holds the DB password and app secret key.
#
# NOTE: the GitHub OIDC IDs (github_owner_id / github_repo_id) moved to
# terraform/bootstrap/terraform.tfvars — the platform root no longer declares
# those variables.

# App-creation workflow (Step 1 — GitHub Setup):
# In CI the required variables come from GitHub Actions:
#   control_plane_url  <- vars.MAKEWAY_CONTROL_PLANE_URL   (TF_VAR_control_plane_url)
#   kube_api_endpoint  <- vars.MAKEWAY_KUBE_API_ENDPOINT   (TF_VAR_kube_api_endpoint)
#   kube_ca_cert       <- vars.MAKEWAY_KUBE_CA_CERT        (TF_VAR_kube_ca_cert, empty for the pinggy TCP tunnel)
#   kube_token         <- secrets.MAKEWAY_KUBE_TOKEN       (TF_VAR_kube_token)
# Secrets (internal_api_key, github_pat) are auto-generated / stored in Secrets
# Manager and never passed through CI.
# For a local deploy supply the non-secret overrides you care about, e.g.:
#   control_plane_url = "http://<alb-dns>.elb.amazonaws.com"
#   github_owner      = "kapil4457"
#   makeway_platform_repo = "Makeway-IDP"

# Secrets are auto-generated on first apply when left empty. Pin values here
# only if you want them under your control (then they live in state):
#   app_secret_key = "<long-random-string>"
#   db_password    = "<postgres-master-password>"
