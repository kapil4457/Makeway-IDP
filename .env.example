# Makeway Control Plane — Environment Configuration
# Copy this to .env and fill in actual values for local/dev deployment.

# --- Database ---
# Local dev (default): a postgres you run yourself, or the Makeway RDS over a
# tunnel — see scripts/tunnel-rds.sh. The host stays localhost; the tunnel
# forwards to RDS in the private VPC.
DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/makeway?sslmode=require

# For the AWS-deployed RDS (through the tunnel), use:
#   DATABASE_URL=postgresql://postgres:<db_password>@localhost:5432/makeway
# where <db_password> is the value from the platform terraform state/tfvars
# (random_password.db_password in terraform/, or var.db_password).

# --- Logging ---
LOG_LEVEL=INFO
FORGE_LOG_DIR=logs
FORGE_LOG_MAX_BYTES=10485760
FORGE_LOG_BACKUPS=5

# --- FastAPI Application ---
APP_TITLE=Makeway API
APP_VERSION=0.1.0
FORGE_API_HOST=127.0.0.1
FORGE_API_PORT=8000

# --- Clusters (EKS / K8s) ---
# Format: clusterName|kubeApiEndpoint|environment
# Register clusters via the cluster registration endpoint
CLUSTER_DEV_ENDPOINT=http://localhost:6443
CLUSTER_DEV_NAME=dev-cluster
CLUSTER_DEV_ENV=dev
CLUSTER_UAT_ENDPOINT=http://localhost:6443
CLUSTER_UAT_NAME=uat-cluster
CLUSTER_UAT_ENV=uat
CLUSTER_PROD_ENDPOINT=http://localhost:6443
CLUSTER_PROD_NAME=prod-cluster
CLUSTER_PROD_ENV=prod

# --- Vault / Secrets ---
# HashiCorp Vault connection for secret management
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=dev-root-token-vault
VAULT_KV_PATH=secret/makeway

# --- Queue / Messaging (SQS for App Creation Queue) ---
SQS_ENDPOINT_URL=http://localhost:4566
SQS_REGION=us-east-1
APP_CREATION_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/makeway-app-creation

# --- ArgoCD / GitOps ---
ARGOCD_API=http://localhost:8080
ARGOCD_TOKEN=argcd-admin-token

# --- Application Defaults ---
# Default capacity tiers applied when not specified
DEFAULT_DATABASE_CAPACITY=1
DEFAULT_STORAGE_TIER=standard

# --- Feature Flags ---
ENABLE_AUTO_APPROVE_DEV=true
ENABLE_AUTO_APPROVE_STAGING=false
REQUIRE_APPROVAL_PRODUCTION=true

# --- Authentication ---
# auth/jwt.py reads JWT_SECRET_KEY / JWT_ALGORITHM / JWT_ACCESS_TOKEN_EXPIRE_MINUTES
# (older names SECRET_KEY / ALGORITHM / ACCESS_TOKEN_EXPIRE_MINUTES are ignored).
JWT_SECRET_KEY=change-this-to-a-secure-random-value
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- AWS / Terraform (if provisioning infra) ---
AWS_DEFAULT_REGION=us-east-1
TF_STATE_BUCKET=makeway-terraform-state
TF_DYNAMODB_TABLE=makeway-tf-lock